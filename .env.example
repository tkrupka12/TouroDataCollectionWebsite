# Heatmap Management API Credentials from Crazy Egg
# Options → site Settings → API → Heatmap Management API Credentials
# Do not use the Conversion Tracking API key.

CRAZY_EGG_API_KEY=
CRAZY_EGG_API_SECRET=

# Re-fetch interval in minutes (not seconds). Default: 15
CRAZY_EGG_REFRESH_MINUTES=15

# Semrush API v4 key (Authorization: Apikey)
SEMRUSH_API_KEY=

# Refresh the cached Semrush JSON every 6 hours
SEMRUSH_REFRESH_HOURS=6

# Ahrefs API v3 key (Authorization: Bearer)
AHREFS_API_KEY=

# Refresh the cached Ahrefs JSON every 6 hours
AHREFS_REFRESH_HOURS=6

# Siteimprove API v2 (Settings → Integrations → API → API Keys)
# Use the API username shown next to the key, plus the key itself.
SITEIMPROVE_API_KEY=
SITEIMPROVE_USERNAME=
SITEIMPROVE_REFRESH_HOURS=6
